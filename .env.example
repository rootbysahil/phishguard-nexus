# ==============================================================================
# PHISHGUARD//NEXUS Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
DATABASE_URL=sqlite:///./app.db

# Machine Learning & Detection Engine
MODEL_PATH=models/best_model.joblib
EXPLAINER_PATH=models/shap_explainer.joblib
THRESHOLD_SAFE=0.35
THRESHOLD_SUSPICIOUS=0.70
HOST_FEATURES_ENABLED=false
DISTILBERT_ENABLED=false

# IBM watsonx.ai Integration
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Security & Rate Limiting
RATE_LIMIT_SCAN="30/minute"
RATE_LIMIT_GLOBAL="120/minute"
MAX_URL_LENGTH=2048
MAX_BODY_BYTES=51200
